    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst id = body.id_solicitud;\nconst monto = body.monto !== undefined ? Number(body.monto) : undefined;\nconst dias = body.dias_desde_compra !== undefined ? Number(body.dias_desde_compra) : undefined;\nconst estado = body.estado_producto;\n\nlet ruta, motivo;\n\nif (id === undefined || id === '') {\n  ruta = 'DATOS_INVALIDOS';\n  motivo = 'id_solicitud vacio';\n} else if (monto === undefined || isNaN(monto) || monto <= 0) {\n  ruta = 'DATOS_INVALIDOS';\n  motivo = 'monto invalido (<=0 o ausente)';\n} else if (dias > 7) {\n  ruta = 'RECHAZO';\n  motivo = 'plazo excedido (>7 dias)';\n} else if (estado === 'danado_por_uso') {\n  ruta = 'RECHAZO';\n  motivo = 'producto danado por uso';\n} else if (monto > 40000) {\n  ruta = 'REVISION';\n  motivo = 'monto supera U=40000';\n} else if (estado === 'con_fallas') {\n  ruta = 'REVISION';\n  motivo = 'producto con fallas';\n} else {\n  ruta = 'APROBACION';\n  motivo = 'cumple todas las condiciones de la politica';\n}\n\nreturn [{ json: {\n  id_solicitud: body.id_solicitud,\n  sku: body.sku,\n  monto: body.monto,\n  dias_desde_compra: body.dias_desde_compra,\n  estado_producto: body.estado_producto,\n  email_cliente: body.email_cliente,\n  ruta,\n  motivo,\n  U: 40000,\n  D: 7\n} }];"
      },
